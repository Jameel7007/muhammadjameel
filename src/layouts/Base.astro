---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** og:type — "article" for posts, "website" otherwise */
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** Nav starts transparent over a full-bleed hero (home only) */
  navOverlay?: boolean;
  /** Hide the nav's top-right links at mobile widths only (home only —
      the hero's bottom link set serves as mobile navigation) */
  navMobileLinks?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og-default.png',
  navOverlay = false,
  navMobileLinks = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Muhammad Jameel" href="/rss.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Muhammad Jameel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav overlay={navOverlay} mobileLinks={navMobileLinks} />
    <slot />
    <Footer />

    <script>
      // Fade-up reveals, matching the design's IntersectionObserver behavior.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');
      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
