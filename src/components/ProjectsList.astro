---
import { getEntry } from 'astro:content';

// Project list copy lives in src/content/site/projects.md. Unlike documents,
// these link out to work hosted elsewhere. Same row rhythm as DocumentsList,
// and like it these styles are written for the band the list sits on —
// here the cream ground, where DocumentsList takes the dark one.
const entry = await getEntry('site', 'projects');
const projects = entry?.data.projects ?? [];
---

<div class="project-list">
  {
    projects.map((project) => (
      <div class="project-row" data-reveal>
        <div class="project-title">{project.title}</div>
        <div class="project-desc">{project.description}</div>
        <a href={project.link} target="_blank" rel="noopener" class="project-link">
          <span class="project-link-text">{project.linkLabel}</span>
          <span class="project-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    ))
  }
</div>

<style>
  .project-list {
    border-top: 1px solid var(--rule);
  }

  /* Title on the first row, description below it, link held bottom-right —
     the same two-column rhythm as the Documents rows. */
  .project-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px clamp(24px, 4vw, 56px);
    align-items: baseline;
    padding: clamp(30px, 4vh, 42px) 0;
    border-bottom: 1px solid var(--rule);
  }

  .project-title {
    grid-column: 1;
    font-style: italic;
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.3;
  }

  .project-desc {
    grid-column: 1;
    font-size: var(--text-ui);
    line-height: 1.6;
    color: var(--ink-65);
    max-width: 56ch;
  }

  .project-link {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-style: italic;
    font-size: var(--text-ui);
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    /* Vertical padding enlarges the tap target without a button box. */
    padding: 8px 0;
  }

  .project-link:hover {
    color: var(--color-accent);
  }

  /* The underline hugs the word, not the padding. */
  .project-link-text {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }

  .project-arrow {
    display: inline-block;
    transition: transform 0.18s var(--ease);
  }

  .project-link:hover .project-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-arrow {
      transition: none;
    }
  }

  /* Narrow: the link drops under the description rather than crowding it. */
  @media (max-width: 600px) {
    .project-row {
      grid-template-columns: 1fr;
    }

    .project-link {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
    }
  }
</style>
