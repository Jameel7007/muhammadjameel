---
interface Props {
  /** When true (home), the nav sits transparent over the green hero and
      turns solid on scroll. Everywhere else it is solid from the start. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<div class:list={['site-nav', { solid: !overlay }]} data-overlay={overlay ? 'true' : 'false'}>
  <a href="/" class="wordmark">Muhammad Jameel</a>
  <nav>
    <a href="/about">Bio</a>
    <a href="/blog">Blog</a>
    <a href="/#books">Books</a>
    <a href="/documents">Documents</a>
  </nav>
</div>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  if (nav && nav.dataset.overlay === 'true') {
    const apply = () => {
      const viewport = window.innerHeight || document.documentElement.clientHeight;
      // Guard against a 0-height viewport (hidden prerender): never let the
      // threshold go negative, or the nav latches solid at scrollY 0.
      nav.classList.toggle('solid', viewport > 0 && window.scrollY > viewport - 90);
    };
    window.addEventListener('scroll', apply, { passive: true });
    window.addEventListener('resize', apply, { passive: true });
    apply();
  }
</script>
