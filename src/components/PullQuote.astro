---
/**
 * Short centred pull quote for MDX posts — the large green epigraph
 * treatment. Plain `>` blockquotes are block citations instead, which
 * is what extended quoted passages need.
 *
 *   import PullQuote from '../../components/PullQuote.astro';
 *
 *   <PullQuote>A book will tell you the truth.</PullQuote>
 */
---

<blockquote class="pull-quote">
  <p><slot /></p>
</blockquote>
