---
import { getEntry } from 'astro:content';

// Document list copy lives in src/content/site/documents.md;
// the PDFs themselves live in public/documents/.
const entry = await getEntry('site', 'documents');
const documents = entry?.data.documents ?? [];
---

<div class="doc-list">
  {
    documents.map((doc) => (
      <div class="doc-row" data-reveal>
        <div class="doc-title">{doc.title}</div>
        <div class="doc-pages">{doc.pages} pages</div>
        <div class="doc-desc">{doc.description}</div>
        <a href={doc.file} class="doc-link" download>
          Download PDF
        </a>
      </div>
    ))
  }
</div>

<style>
  .doc-list {
    border-top: 1px solid var(--cream-rule);
  }

  .doc-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px clamp(24px, 4vw, 56px);
    align-items: baseline;
    padding: clamp(30px, 4vh, 42px) 0;
    border-bottom: 1px solid var(--cream-rule);
  }

  .doc-title {
    font-style: italic;
    font-size: clamp(21px, 2.4vw, 26px);
    line-height: 1.3;
  }

  .doc-pages {
    font-size: var(--text-small);
    color: var(--cream-50);
    white-space: nowrap;
  }

  .doc-desc {
    font-size: var(--text-ui);
    line-height: 1.6;
    color: var(--cream-62);
    max-width: 56ch;
  }

  .doc-link {
    font-style: italic;
    font-size: var(--text-ui);
    color: var(--color-cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(250, 250, 247, 0.35);
    padding-bottom: 2px;
    white-space: nowrap;
    justify-self: end;
  }

  .doc-link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
</style>
