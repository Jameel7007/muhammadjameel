---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

// The author bio, used on the home page (short) and on /about (full).
// All text lives in src/content/site/bio.md. The short variant shows
// the paragraphs above the <!-- homepage-end --> marker (at most two)
// followed by a link to the full biography.
interface Props {
  variant?: 'full' | 'short';
}

const { variant = 'full' } = Astro.props;

const bio = await getEntry('site', 'bio');
if (!bio) throw new Error('Missing site copy: src/content/site/bio.md');
const { Content } = await render(bio);

const HOMEPAGE_MARKER = '<!-- homepage-end -->';
const shortParagraphs =
  variant === 'short'
    ? (bio.body ?? '')
        .split(HOMEPAGE_MARKER)[0]
        .split(/\n\s*\n/)
        .map((p) => p.trim())
        .filter(Boolean)
        .slice(0, 2)
    : [];
---

<div class:list={['bio-grid', variant]}>
  <div class="portrait" data-reveal>
    <Image
      src={portrait}
      alt="Muhammad Jameel"
      widths={[420, 840]}
      sizes="(max-width: 767px) 100vw, 420px"
    />
  </div>
  <div class="bio-text" data-reveal>
    {
      variant === 'short' ? (
        <>
          {shortParagraphs.map((p) => (
            <p>{p}</p>
          ))}
          <a href="/about" class="link-underline read-more">
            Read the full biography
          </a>
        </>
      ) : (
        <Content />
      )
    }
  </div>
</div>
{variant === 'full' && <blockquote class="bio-quote" data-reveal>{bio.data.quote}</blockquote>}

<style>
  .bio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(44px, 6vw, 96px);
    align-items: start;
  }

  .portrait {
    max-width: 420px;
    aspect-ratio: 3 / 4;
  }

  /* Desktop: the portrait pins while the bio text scrolls past, and
     releases when its grid row (the bio text) ends. Offset clears the
     fixed header (~90px tall) plus breathing room. */
  @media (min-width: 768px) {
    .portrait {
      position: sticky;
      top: 130px;
    }

    /* Short variant (homepage): the two-paragraph text column is taller
       than the 3:4 portrait, which left an empty band under the photo.
       Stretch the portrait to the text column's height (object-fit crop)
       so both columns end together and the section height is driven by
       its content. */
    .bio-grid.short {
      align-items: stretch;
    }

    .bio-grid.short .portrait {
      aspect-ratio: auto;
      height: auto;
    }
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 26px;
    font-size: var(--text-body);
    line-height: 1.75;
    max-width: 66ch;
  }

  .bio-text :global(p) {
    margin: 0;
  }

  .read-more {
    align-self: flex-start;
    margin-top: 8px;
  }

  .bio-quote {
    max-width: 23em;
    margin: clamp(80px, 12vh, 140px) auto 0;
    text-align: center;
    font-style: italic;
    font-size: clamp(24px, 3vw, 33px);
    line-height: 1.5;
    color: var(--color-green);
  }
</style>
