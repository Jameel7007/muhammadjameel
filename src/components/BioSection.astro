---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

// The author bio, used on the home page and on /about.
// All text lives in src/content/site/bio.md.
const bio = await getEntry('site', 'bio');
if (!bio) throw new Error('Missing site copy: src/content/site/bio.md');
const { Content } = await render(bio);
---

<div class="bio-grid">
  <div class="portrait" data-reveal>
    <Image
      src={portrait}
      alt="Muhammad Jameel"
      widths={[420, 840]}
      sizes="(max-width: 767px) 100vw, 420px"
    />
  </div>
  <div class="bio-text" data-reveal>
    <Content />
  </div>
</div>
<blockquote class="bio-quote" data-reveal>{bio.data.quote}</blockquote>

<style>
  .bio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(44px, 6vw, 96px);
    align-items: start;
  }

  .portrait {
    max-width: 420px;
    aspect-ratio: 3 / 4;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 26px;
    font-size: var(--text-body);
    line-height: 1.75;
    max-width: 66ch;
  }

  .bio-text :global(p) {
    margin: 0;
  }

  .bio-quote {
    max-width: 23em;
    margin: clamp(80px, 12vh, 140px) auto 0;
    text-align: center;
    font-style: italic;
    font-size: clamp(24px, 3vw, 33px);
    line-height: 1.5;
    color: var(--color-green);
  }
</style>
