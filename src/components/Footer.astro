---
import { getEntry } from 'astro:content';

// All footer text lives in src/content/site/footer.md.
const entry = await getEntry('site', 'footer');
if (!entry) throw new Error('Missing site copy: src/content/site/footer.md');
const copy = entry.data;
const year = new Date().getFullYear();

// Buttondown subscribe endpoint (username set in footer.md). The form
// posts here; the script below intercepts submit so the reader stays
// on the page and sees our own thank-you instead of Buttondown's.
const subscribeAction = copy.buttondownUsername
  ? `https://buttondown.com/api/emails/embed-subscribe/${copy.buttondownUsername}`
  : undefined;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="newsletter">
      <h2>{copy.newsletterHeading}</h2>
      <p class="newsletter-blurb">{copy.newsletterBlurb}</p>
      <form class="subscribe-form" action={subscribeAction} method="POST">
        <input
          type="email"
          name="email"
          required
          placeholder={copy.emailPlaceholder}
          aria-label="Email address"
        />
        <button type="submit">{copy.subscribeLabel}</button>
      </form>
      <p class="subscribe-thanks" hidden>{copy.subscribeThanks}</p>
      <p class="subscribe-error" role="alert" hidden>{copy.subscribeError}</p>
    </div>
    <div class="footer-bottom">
      <div class="social">
        {
          (copy.social ?? []).map((s) => (
            <a href={s.url} target="_blank" rel="noopener">
              {s.label}
            </a>
          ))
        }
      </div>
      <div class="copyright">© {year} {copy.copyright}</div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-oxblood);
    color: var(--color-cream);
    padding: clamp(80px, 12vh, 140px) var(--pad-x) 44px;
    box-sizing: border-box;
  }

  .footer-inner {
    max-width: var(--measure-wide);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 8vh, 88px);
  }

  .newsletter {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    text-align: center;
  }

  .newsletter h2 {
    margin: 0;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.2;
  }

  .newsletter-blurb {
    margin: 0;
    max-width: 36em;
    font-size: var(--text-detail);
    line-height: 1.6;
    color: rgba(250, 250, 247, 0.85);
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
    width: 100%;
    max-width: 520px;
  }

  .subscribe-form input {
    flex: 1;
    min-width: 220px;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(250, 250, 247, 0.6);
    color: var(--color-cream);
    font-family: var(--font-serif);
    font-size: var(--text-detail);
    padding: 10px 2px;
    outline: none;
  }

  .subscribe-form input::placeholder {
    color: rgba(250, 250, 247, 0.55);
  }

  .subscribe-form button {
    background: transparent;
    border: 1px solid var(--color-cream);
    color: var(--color-cream);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-ui);
    padding: 10px 26px;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .subscribe-form button:hover {
    background: var(--color-cream);
    color: var(--color-oxblood);
  }

  .subscribe-thanks {
    margin: 8px 0 0;
    font-style: italic;
    font-size: 18px;
  }

  .subscribe-error {
    margin: 4px 0 0;
    font-style: italic;
    font-size: var(--text-ui);
    color: rgba(250, 250, 247, 0.85);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    border-top: 1px solid rgba(250, 250, 247, 0.35);
    padding-top: 28px;
  }

  .social {
    display: flex;
    gap: 26px;
    font-style: italic;
    font-size: var(--text-ui);
  }

  .social a {
    color: var(--color-cream);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .social a:hover {
    color: var(--color-cream);
    border-bottom-color: var(--color-cream);
  }

  .copyright {
    font-size: var(--text-small);
    color: var(--cream-75);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.subscribe-form');
  const thanks = document.querySelector<HTMLElement>('.subscribe-thanks');
  const error = document.querySelector<HTMLElement>('.subscribe-error');
  // Submit to Buttondown in the background and show our own thank-you —
  // the reader never leaves the page. The response is opaque (no-cors),
  // so we can't read a status code: a resolved fetch means the request
  // reached Buttondown, and a rejection means it never left (offline,
  // DNS, blocked), which is what the inline error covers.
  if (form && thanks && error) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const action = form.getAttribute('action');
      const email = (form.querySelector('input[name="email"]') as HTMLInputElement).value;
      error.hidden = true;
      if (action) {
        if (button) button.disabled = true;
        try {
          await fetch(action, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ email }),
          });
        } catch {
          // Request never left the browser — keep the form so they can retry.
          if (button) button.disabled = false;
          error.hidden = false;
          return;
        }
        if (button) button.disabled = false;
      }
      form.hidden = true;
      thanks.hidden = false;
    });
  }
</script>
