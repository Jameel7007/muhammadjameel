---
import { getEntry } from 'astro:content';

// All footer text lives in src/content/site/footer.md.
const entry = await getEntry('site', 'footer');
if (!entry) throw new Error('Missing site copy: src/content/site/footer.md');
const copy = entry.data;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="newsletter">
      <h2>{copy.newsletterHeading}</h2>
      <p class="newsletter-blurb">{copy.newsletterBlurb}</p>
      <!-- Wire this form to your newsletter provider (Buttondown, Mailchimp, etc.)
           by setting the action/method below. Until then it shows a local thank-you. -->
      <form class="subscribe-form">
        <input
          type="email"
          required
          placeholder={copy.emailPlaceholder}
          aria-label="Email address"
        />
        <button type="submit">{copy.subscribeLabel}</button>
      </form>
      <p class="subscribe-thanks" hidden>{copy.subscribeThanks}</p>
    </div>
    <div class="footer-bottom">
      <div class="social">
        {
          (copy.social ?? []).map((s) => (
            <a href={s.url} target="_blank" rel="noopener">
              {s.label}
            </a>
          ))
        }
      </div>
      <div class="copyright">© {year} {copy.copyright}</div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-accent);
    color: var(--color-cream);
    padding: clamp(80px, 12vh, 140px) var(--pad-x) 44px;
    box-sizing: border-box;
  }

  .footer-inner {
    max-width: var(--measure-wide);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 8vh, 88px);
  }

  .newsletter {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    text-align: center;
  }

  .newsletter h2 {
    margin: 0;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.2;
  }

  .newsletter-blurb {
    margin: 0;
    max-width: 36em;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(250, 250, 247, 0.85);
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
    width: 100%;
    max-width: 520px;
  }

  .subscribe-form input {
    flex: 1;
    min-width: 220px;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(250, 250, 247, 0.6);
    color: var(--color-cream);
    font-family: var(--font-serif);
    font-size: 17px;
    padding: 10px 2px;
    outline: none;
  }

  .subscribe-form input::placeholder {
    color: rgba(250, 250, 247, 0.55);
  }

  .subscribe-form button {
    background: transparent;
    border: 1px solid var(--color-cream);
    color: var(--color-cream);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    padding: 10px 26px;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .subscribe-form button:hover {
    background: var(--color-cream);
    color: var(--color-accent);
  }

  .subscribe-thanks {
    margin: 8px 0 0;
    font-style: italic;
    font-size: 18px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    border-top: 1px solid rgba(250, 250, 247, 0.35);
    padding-top: 28px;
  }

  .social {
    display: flex;
    gap: 26px;
    font-style: italic;
    font-size: 16px;
  }

  .social a {
    color: var(--color-cream);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .social a:hover {
    color: var(--color-cream);
    border-bottom-color: var(--color-cream);
  }

  .copyright {
    font-size: 15px;
    color: var(--cream-75);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.subscribe-form');
  const thanks = document.querySelector<HTMLElement>('.subscribe-thanks');
  // No provider is wired up yet: if the form has no action, show the design's
  // thank-you state locally instead of navigating.
  if (form && thanks && !form.getAttribute('action')) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.hidden = true;
      thanks.hidden = false;
    });
  }
</script>
