---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Captioned image for posts (MDX). Usage:
 *
 *   import Figure from '../../../components/Figure.astro';
 *   import photo from './photo.jpg';
 *
 *   <Figure src={photo} alt="…" caption="…" />
 *
 * `src` takes an imported co-located image (optimized through astro:assets)
 * or a plain string path/URL for images in public/ or remote.
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="post-figure">
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} />
    ) : (
      <Image src={src} alt={alt} widths={[680, 1360]} sizes="(max-width: 728px) 100vw, 680px" />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-figure {
    margin: 36px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-figure :is(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    font-size: var(--text-small);
    font-style: italic;
    color: var(--ink-50);
    text-align: center;
    line-height: 1.5;
  }
</style>
