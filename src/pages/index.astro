---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BioSection from '../components/BioSection.astro';
import DocumentsList from '../components/DocumentsList.astro';
import PostRow from '../components/PostRow.astro';
import { getPublishedPosts, longDate, readingTime } from '../lib/posts';

// Featured-plus-recent: one flagged post gets the large treatment,
// followed by the next two most recent. With no flag, latest three.
const allPosts = await getPublishedPosts();
const featuredPost = allPosts.find((p) => p.data.featured) ?? null;
const posts = featuredPost
  ? allPosts.filter((p) => p !== featuredPost).slice(0, 2)
  : allPosts.slice(0, 3);

// The pull quote lives in bio.md frontmatter (shared with /about).
const bioEntry = await getEntry('site', 'bio');
const pullQuote = bioEntry?.data.quote;

// Book copy lives in src/content/site/books.md.
const booksEntry = await getEntry('site', 'books');
const books = booksEntry?.data.books ?? [];
const coverColors = {
  green: 'var(--color-green)',
  ink: 'var(--color-ink)',
  red: 'var(--color-accent)',
} as const;
---

<Base
  title="Muhammad Jameel — Author"
  description="Author of Sufism & The Nation of Islam, Death of the Scholars, and Religious Exemption. Essays on the science of the heart."
  navOverlay
  navMobileLinks={false}
>
  <section id="hero" class="hero">
    <div class="hero-center">
      <h1>Muhammad Jameel</h1>
      <p class="hero-sub">Author</p>
    </div>
    <div class="hero-links">
      <a href="/blog">Blog</a>
      <a href="/about">Bio</a>
      <a href="#books">Books</a>
      <a href="/documents">Documents</a>
    </div>
  </section>

  <section id="bio" class:list={['section', { 'seam-collapse-bottom': pullQuote }]}>
    <div class="inner-max">
      <div class="section-label" data-reveal>Bio</div>
      <BioSection variant="short" />
    </div>
  </section>

  {
    pullQuote && (
      <section class="quote-break" aria-label="Quote">
        <blockquote class="pull-quote">{pullQuote}</blockquote>
      </section>
    )
  }

  <section id="blog" class:list={['section', 'blog-section', { 'seam-collapse-top': pullQuote }]}>
    <div class="inner-wide">
      <!-- The label and the featured post rise together as one unit, on the
           site-wide [data-reveal] observer — same behaviour as the Documents
           and Books sections. -->
      <div class:list={['featured-region', { 'has-featured': featuredPost }]} data-reveal>
        <div class="section-label">Blog</div>
        {
          featuredPost && (
            <a href={`/blog/${featuredPost.id}/`} class="featured-post">
              <div class="featured-label">Featured</div>
              <h3>{featuredPost.data.title}</h3>
              <p class="featured-desc">{featuredPost.data.description}</p>
              <div class="post-meta">
                <span>{longDate(featuredPost.data.date)}</span>
                <span>{readingTime(featuredPost.body)} min read</span>
              </div>
              <!-- Optional affordance: delete this span (and the
                   .featured-read CSS rules) to remove it. -->
              <span class="featured-read">
                <span class="featured-read-text">Read</span>
                <span class="featured-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          )
        }
      </div>
      <div class="post-list">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
      <div class="all-posts" data-reveal>
        <a href="/blog" class="link-underline">All posts</a>
      </div>
    </div>
  </section>

  <section id="books" class="section">
    <div class="inner-max">
      <div class="section-label" data-reveal>Books</div>
      <div class="books-grid">
        {
          books.map((book) => (
            <div class="book" data-reveal>
              <div class="book-cover" style={`background:${coverColors[book.cover]}`}>
                <div class="book-title">
                  {book.titleLines.map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </div>
                <div class="book-author">Muhammad Jameel</div>
              </div>
              <p class="book-desc">{book.description}</p>
              <a href={book.link} target="_blank" rel="noopener" class="btn-outline">
                {book.buyLabel}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="documents" class="section section-dark">
    <div class="inner-wide">
      <div class="section-label" data-reveal>Documents</div>
      <DocumentsList />
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100svh;
    background: var(--color-green);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    padding: 120px 24px 56px;
    text-align: center;
  }

  .hero-center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(22px, 3vh, 34px);
  }

  .hero h1 {
    margin: 0;
    color: var(--color-cream);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(46px, 8.5vw, 124px);
    line-height: 1.06;
    letter-spacing: 0.005em;
    animation: heroFade 1.1s var(--ease) 0.15s both;
  }

  .hero-sub {
    margin: 0;
    max-width: 34em;
    color: var(--cream-82);
    font-style: italic;
    font-size: clamp(24px, 3vw, 33px);
    letter-spacing: 0.06em;
    line-height: 1.5;
    animation: heroFade 1.1s var(--ease) 0.5s both;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(22px, 4.5vw, 60px);
    font-size: var(--text-hero-link);
    letter-spacing: 0.02em;
    font-style: italic;
    animation: heroFade 1.1s var(--ease) 0.85s both;
  }

  .hero-links a {
    cursor: pointer;
    text-decoration: none;
    color: var(--color-cream);
    border-bottom: 1px solid rgba(250, 250, 247, 0.35);
    padding-bottom: 3px;
    white-space: nowrap;
  }

  .hero-links a:hover {
    color: var(--color-cream);
    border-bottom-color: var(--color-cream);
  }

  /* Desktop: slightly lower underline for the larger links */
  @media (min-width: 768px) {
    .hero-links a {
      padding-bottom: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero h1,
    .hero-sub,
    .hero-links {
      animation: none;
    }
  }

  .inner-max {
    max-width: var(--measure-max);
    margin: 0 auto;
  }

  .inner-wide {
    max-width: var(--measure-wide);
    margin: 0 auto;
  }

  .all-posts {
    padding-top: clamp(36px, 5vh, 52px);
  }

  /* Pull quote: lives INSIDE the bio→blog transition rather than adding
     a third gap. The neighboring section paddings collapse on this seam
     (see .seam-collapse-*) and this one symmetric band owns the whole
     transition, keeping it near the site's 224px section rhythm. Ink,
     not green — the featured title below carries the green. Fades up
     once when it enters the viewport (script below); transform-based,
     so the space is reserved and nothing shifts when it fires. */
  .quote-break {
    background: var(--color-bg);
    padding: clamp(60px, 8.5vh, 76px) var(--pad-x);
    box-sizing: border-box;
  }

  .seam-collapse-bottom {
    padding-bottom: 0;
  }

  .seam-collapse-top {
    padding-top: 0;
  }

  .pull-quote {
    max-width: 23em;
    margin: 0 auto;
    text-align: center;
    font-style: italic;
    font-size: clamp(24px, 3vw, 33px);
    line-height: 1.5;
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
  }

  .pull-quote.revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pull-quote {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Featured post: the same reading language as the index rows, one
     step up in scale, set apart by the site green and extra air —
     typography and spacing only, no fills or borders. */
  .featured-post {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(28px, 5vh, 56px) 0 clamp(88px, 12vh, 124px);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  /* The featured block carries its own 40px top padding, so the blog
     label's margin is trimmed to keep label→featured (16 + 40 = 56)
     level with how BOOKS/DOCUMENTS labels sit above their content.
     With no featured post the label sits straight above the post list,
     so it keeps the standard --label-gap like every other section. */
  .featured-region.has-featured .section-label {
    margin-bottom: 16px;
  }

  .featured-post h3 {
    color: var(--color-green);
  }

  .featured-post:hover {
    color: var(--color-accent);
  }

  .featured-post:hover h3 {
    color: var(--color-accent);
  }

  .featured-label {
    font-size: var(--text-meta);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* The post rows and the All-posts link below stay static — the featured
     region is the only thing that animates in this section. Scoped so it
     cannot touch .featured-region's own [data-reveal]. */
  .blog-section .post-list :global([data-reveal]),
  .blog-section .all-posts {
    opacity: 1;
    transform: none;
    transition: none;
  }

  /* Optional Read → affordance. Delete with the span. */
  .featured-read {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-style: italic;
    font-size: var(--text-detail);
    /* Vertical padding enlarges the tap target without a button box; the
       underline hugs the word, not the padding. */
    padding: 8px 0;
  }

  .featured-read-text {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }

  .featured-arrow {
    display: inline-block;
    transition: transform 0.18s var(--ease);
  }

  .featured-post:hover .featured-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-post > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .featured-post h3 {
    margin: 0;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(38px, 5vw, 54px);
    line-height: 1.15;
    text-wrap: pretty;
  }

  .featured-desc {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink-65);
    max-width: 60ch;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(40px, 5vw, 72px);
  }

  .book {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .book-cover {
    aspect-ratio: 2 / 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    padding: 12% 10%;
    text-align: center;
    transition: transform 0.5s var(--ease);
  }

  .book-cover:hover {
    transform: translateY(-8px);
  }

  .book-title {
    color: var(--color-cream);
    font-style: italic;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.3;
  }

  .book-author {
    color: var(--color-cream);
    font-style: italic;
    font-size: var(--text-meta);
  }

  .book-desc {
    margin: 0;
    font-size: var(--text-detail);
    line-height: 1.6;
    color: var(--ink-70);
  }

  /* Mobile: covers render near full-width, so their text scales up to
     keep the same visual presence it has on desktop. Desktop unchanged. */
  @media (max-width: 767px) {
    .book-title {
      font-size: clamp(26px, 7.5vw, 30px);
    }

    .book-author {
      font-size: var(--text-ui);
    }
  }

  .section-dark {
    background: var(--color-ink);
    color: var(--color-cream);
  }
</style>

<script>
  // Pull quote: fades up once when a quarter of it is visible, then stays.
  // Everything else on this page uses the site-wide [data-reveal] observer
  // in Base.astro. Reduced-motion users (handled in CSS too) see it at once.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const quote = document.querySelector('.pull-quote');

  if (quote) {
    if (reduced || !('IntersectionObserver' in window)) {
      quote.classList.add('revealed');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              quote.classList.add('revealed');
              io.disconnect();
            }
          }
        },
        { threshold: 0.25 }
      );
      io.observe(quote);
    }
  }
</script>
